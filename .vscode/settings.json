{
    "files.exclude": {
        "dev/": true,
        "dist/": true,
        "src/mp/": true,
        "src/baseline/": true,
        //"src/Assets/": true,
        "deps/**/temp/": true
    },
    "Lua.runtime.version": "Lua 5.1",
    "Lua.runtime.builtin": {
        "io": "disable",
        "os": "disable",
        "bit": "disable", // LuaLS complains that the module is LuaJIT only if we enable it so we just document it ourselves
    },
    "Lua.workspace.library": [
        "deps/BZ98R-Advanced-Lua-API/dev/scriptutils.lua",
        "deps/BZ98R-Advanced-Lua-API/baked",
        "src/scripts"
    ],
    "Lua.workspace.ignoreDir": [
        "deps/BZ98R-Advanced-Lua_API/dev/preprocessor.lua",
    ]
}